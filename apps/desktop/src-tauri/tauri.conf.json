{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseBench",
  "version": "0.1.0",
  "identifier": "dev.zeropulse.pulsebench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PulseBench",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#070b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ZeroPulse",
    "copyright": "© ZeroPulse. MIT licensed.",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI coding model benchmarks",
    "longDescription": "PulseBench runs local AI coding models against real software-engineering tasks, executes their solutions, verifies them with tests and produces reproducible scores on your hardware.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../../benchmarks": "benchmarks"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
